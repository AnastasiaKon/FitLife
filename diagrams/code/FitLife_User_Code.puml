@startuml

class User {
  -String name
  -String email
  +register()
  +login()
}

class Membership {
  -String type
  -Date startDate
  -Date endDate
  +activate()
  +cancel()
}

class Schedule {
  -Date date
  -String activity
  +addActivity()
  +removeActivity()
}

class Payment {
  -double amount
  -Date date
  +processPayment()
}

User "1" -- "1..*" Membership : has
Membership "1" -- "1..*" Schedule : includes
Membership "1" -- "0..*" Payment : paid by

@enduml